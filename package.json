{
  "name": "llmgo",
  "version": "0.1.0",
  "private": true,
  "description": "LLMgo desktop Go AI teacher",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "npm run typecheck && vite build && tsc -p desktop/electron/tsconfig.json",
    "typecheck": "tsc -p desktop/tsconfig.json && tsc -p desktop/electron/tsconfig.json --noEmit",
    "start": "electron .",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "build:core": "node scripts/build-core.cjs",
    "package": "npm run build && npm run build:core && electron-builder --win dir"
  },
  "dependencies": {
    "@sabaki/shudan": "^1.8.0",
    "preact": "^10.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.51.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "app.llmgo.desktop",
    "productName": "LLMgo",
    "directories": {"output": "release"},
    "files": ["dist/renderer/**/*", "dist/electron/**/*", "package.json"],
    "extraResources": [{"from": "dist/core-build/llmgo-core", "to": "core"}],
    "win": {"target": "dir", "signAndEditExecutable": false}
  }
}
